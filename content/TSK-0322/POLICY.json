{
  "schema": "usesafeweb.product-language-policy.v2",
  "task_id": "TSK-0322",
  "version": "2.0.0-post-cr0007",
  "status": "internal_l4",
  "owner": "Content",
  "visible_brand": "SafeWeb",
  "domain_identifier": "UseSafeWeb.com",
  "parent_facing_dns_term": "SafeWeb DNS",
  "technical_endpoints": {
    "android_private_dns_hostname": "dns.usesafeweb.com",
    "iphone_doh_url": "https://dns.usesafeweb.com/dns-query"
  },
  "voice": [
    "calm",
    "clear",
    "respectful",
    "protective_not_controlling",
    "truthful",
    "practical",
    "quietly_trustworthy"
  ],
  "reading_goal": {
    "plain_general_audience_language": true,
    "one_material_idea_per_sentence_where_practical": true,
    "technical_jargon_only_when_needed": true,
    "fixed_numeric_grade_level_authorized": false,
    "truth_over_readability_score": true
  },
  "child_readable": {
    "neutral_non_blame": true,
    "no_fear_or_shame": true,
    "no_surveillance_framing": true,
    "no_child_account_implied": true,
    "preserve_evidence_strength": true
  },
  "states": [
    {
      "id": "S1",
      "label": "Verified",
      "evidence": "current_qualifying_technical_evidence"
    },
    {
      "id": "S2",
      "label": "You confirmed this is set up",
      "evidence": "parent_confirmation_not_system_verification"
    },
    {
      "id": "S3",
      "label": "Action needed",
      "evidence": "applicable_incomplete_or_known_repair"
    },
    {
      "id": "S4",
      "label": "Not covered",
      "evidence": "unsupported_out_of_scope_or_no_approved_safeguard"
    },
    {
      "id": "S5",
      "label": "Status uncertain",
      "evidence": "conflicting_inconclusive_stale_or_unavailable_evidence"
    },
    {
      "id": "S6",
      "label": "Removed",
      "evidence": "configuration_or_safeguard_no_longer_active"
    }
  ],
  "truth_invariants": [
    "parent_confirmation_never_equals_verified",
    "configuration_presence_alone_never_equals_verified",
    "material_contradiction_invalidates_stale_positive_state",
    "removal_withdraws_active_protection_claim",
    "journey_completion_does_not_imply_overall_protection",
    "critical_state_meaning_is_not_color_only",
    "protection_map_is_not_a_safety_score",
    "account_or_saved_device_presence_never_equals_verified",
    "provider_or_session_failure_never_rewrites_physical_protection_truth",
    "logout_account_delete_record_delete_revoke_unlink_and_physical_dns_removal_are_distinct",
    "unknown_destructive_result_never_implies_success_or_automatic_replay"
  ],
  "approved_claims": [
    "SafeWeb helps you set up sensible first-phone safeguards.",
    "SafeWeb brings the phone, internet baseline, and one relevant service safeguard into one clear setup path.",
    "SafeWeb shows what it verified, what you confirmed, what needs attention, and what is not covered.",
    "SafeWeb is designed to minimize identity and journey data.",
    "SafeWeb is not a child browsing or activity monitoring product.",
    "You can remove the supported SafeWeb DNS configuration and follow recovery guidance.",
    "Starting over resets the web setup journey; it does not remove SafeWeb DNS from the phone.",
    "DNS filtering works at the domain-resolution layer. It does not inspect content inside an allowed app or site.",
    "You do not need a SafeWeb account for the core setup, verification, help, recovery, or removal journey.",
    "An optional parent account can provide continuity and a lightweight saved-device dashboard.",
    "A saved device or signed-in account does not by itself mean protection is Verified.",
    "Logging out changes account access only; it does not remove SafeWeb DNS from a device.",
    "Deleting a saved device record is different from removing SafeWeb DNS from the physical device."
  ],
  "prohibited_claim_classes": [
    "complete_or_guaranteed_safety",
    "overall_child_safe_or_protected_outcome",
    "surveillance_or_full_parental_control",
    "verified_from_parent_confirmation_or_presence_only",
    "impossible_to_bypass_or_always_protected",
    "absolute_zero_data_or_anonymity_without_proof",
    "legal_certification_or_full_compliance_without_authority",
    "fabricated_parent_validation_or_comprehension",
    "unsupported_superiority_or_uniqueness",
    "fear_shame_or_parental_negligence",
    "universal_device_network_market_or_launch_support",
    "fabricated_staffed_support",
    "pay_for_better_safety",
    "mandatory_login_for_core_value",
    "browsing_query_activity_history_product",
    "child_accounts_or_profiles",
    "broad_or_raw_dns_administration",
    "account_device_or_dashboard_presence_as_technical_verification",
    "automatic_j0_j1_to_account_linkage_or_expiry_extension",
    "lifecycle_operation_conflation",
    "unknown_destructive_result_as_success_or_automatic_replay"
  ],
  "completion_copy": "Setup complete. Review what SafeWeb verified, what you confirmed, and what is not covered.",
  "localization": {
    "source_semantics": "en",
    "required_first_public_languages": [
      "en",
