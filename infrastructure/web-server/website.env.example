# Install as /etc/usesafeweb/website.env with mode 0600 and root ownership.
# Values are intentionally empty; never commit the populated file.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3100
NEXT_TELEMETRY_DISABLED=1
USESAFEWEB_PUBLIC_ORIGIN=
USESAFEWEB_DNS_VERIFICATION_SIGNING_SECRET=
USESAFEWEB_RELEASE_SHA=
