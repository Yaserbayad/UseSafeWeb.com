# External DNS-01 tooling must provision this exact wildcard certificate.
# Never store the certificate private key or DNS-provider credential in Git.
USESAFEWEB_VERIFIER_CERTIFICATE=/etc/letsencrypt/live/verify.usesafeweb.com/fullchain.pem
USESAFEWEB_VERIFIER_PRIVATE_KEY=/etc/letsencrypt/live/verify.usesafeweb.com/privkey.pem
USESAFEWEB_PUBLIC_APPLICATION_HOST=
USESAFEWEB_PUBLIC_CERTIFICATE=
USESAFEWEB_PUBLIC_PRIVATE_KEY=
USESAFEWEB_TLS_TRUST_BUNDLE=/etc/ssl/certs/ca-certificates.crt
