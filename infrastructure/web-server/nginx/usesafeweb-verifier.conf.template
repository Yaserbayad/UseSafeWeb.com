# Render with render-verifier-config.py.  This file is included from nginx's
# http context; it deliberately owns the default listeners so no other virtual
# host can accidentally become the verifier.
limit_req_zone $binary_remote_addr zone=usesafeweb_verifier:1m rate=12r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    access_log off;
    return 444;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    access_log off;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ~^[0-9a-f]{32}\.verify\.usesafeweb\.com$;

    ssl_certificate __TLS_CERTIFICATE__;
    ssl_certificate_key __TLS_PRIVATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;

    access_log off;
    # Per-request verifier errors are not retained because they can contain the
    # ephemeral challenge hostname. Configuration/startup errors remain in the
    # main nginx service journal.
    error_log /dev/null crit;
    client_max_body_size 4k;
    client_body_timeout 5s;
    send_timeout 10s;
    limit_req_status 429;

    location = /api/dns-verification/probes {
        if ($args != "") { return 404; }
        limit_except POST { deny all; }
        limit_req zone=usesafeweb_verifier burst=4 nodelay;
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header Connection "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Real-IP "";
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        proxy_send_timeout 5s;
        proxy_intercept_errors on;
        error_page 500 502 503 504 =503 @verifier_unavailable;
    }

    location @verifier_unavailable { return 503; }

    location / {
        return 404;
    }
}
