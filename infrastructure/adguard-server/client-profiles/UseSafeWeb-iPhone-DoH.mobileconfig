            <string>com.apple.dnsSettings.managed</string>
            <key>PayloadUUID</key>
            <string>CB1C1FBD-C86D-4100-8869-DAB8EF52B17B</string>
            <key>PayloadVersion</key>
            <integer>1</integer>
        </dict>
    </array>
    <key>PayloadDescription</key>
    <string>Configures UseSafeWeb encrypted DNS over HTTPS. Remove this profile to restore the device's normal DNS settings.</string>
    <key>PayloadDisplayName</key>
    <string>UseSafeWeb Encrypted DNS</string>
